+    /// Adds the rules mods registered, with the values `world` has; Done writes the changed
+    /// ones back. Only the screen of a world this game runs has them (not a remote server's, not
+    /// Create New World's: those worlds have no values of Fish's to read or write).
+    pub fn with_fish(mut self, world: Option<String>) -> Self {
+        let (Some(fish), Some(world)) = (fish_hooks::get(), world) else {
+            return self;
+        };
+        let mut defs = Vec::new();
+        fish.game_rules(&mut defs);
+        self.fish = defs
+            .into_iter()
+            .map(|def| {
+                let value = fish
+                    .game_rule_get(&world, &def.name)
+                    .unwrap_or_else(|| def.default.clone());
+                let input = matches!(
+                    def.kind,
+                    fish_hooks::RuleKind::Int { .. } | fish_hooks::RuleKind::Double { .. }
+                )
+                .then(|| {
+                    let mut b = EditBox::new(0.0, 0.0, 44.0, 20.0);
+                    b.focused = false;
+                    b.set_value(&value.to_string());
+                    b.text_color = VALID;
+                    b
+                });
+                FishRule {
+                    category: fish_category(&def.category),
+                    initial: value.clone(),
+                    value,
+                    input,
+                    def,
+                }
+            })
+            .collect();
+        self.fish_world = Some(world);
+        self
+    }
+    /// Done: writes the mods' changed rules to the world.
+    fn apply_fish(&mut self) {
+        let (Some(fish), Some(world)) = (fish_hooks::get(), self.fish_world.clone()) else {
+            return;
+        };
+        for rule in self.fish.iter_mut().filter(|r| r.changed()) {
+            if fish.game_rule_set(&world, &rule.def.name, &rule.value).is_ok() {
+                rule.initial = rule.value.clone();
+            }
+        }
+    }
