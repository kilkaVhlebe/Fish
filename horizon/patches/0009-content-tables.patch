 /// `VibrationSystem.getGameEventFrequency`.
 pub fn frequency(event: &str) -> i32 {
+    // Fish: a frequency a mod gave the game event (`fish:content`) wins.
+    if let Some(frequency) = crate::fish_lib::sculk_frequency(event) {
+        return frequency;
+    }
     if let Some(i) = RESONANCE.iter().position(|e| *e == event) {
         return i as i32 + 1;
     }
