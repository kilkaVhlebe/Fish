+/// Fish: the fire odds mods gave blocks (`fish:content`), over the loaded tables. The snapshot keeps
+/// the game's own odds, so a change of the mods never meets stale ones.
+fn fish_fire_odds(behaviours: &mut Behaviours, registry: &BlockRegistry) {
+    let Some(d) = fish_hooks::get() else {
+        return;
+    };
+    for f in d.content_tables().flammables {
+        let Some(state) = registry.default_state(&f.block) else {
+            continue;
+        };
+        let block = behaviours.table.block(state);
+        if let Some(data) = behaviours.blocks.get_mut(block.0 as usize) {
+            data.ignite_odds = f.ignite_odds;
+            data.burn_odds = f.burn_odds;
+        }
+    }
+}
